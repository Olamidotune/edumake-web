// **************************************************************************
// JsonSerializableGenerator
// **************************************************************************

EventClass _$EventClassFromJson(Map<String, dynamic> json) => EventClass(
      id: json['_id'] as String,
      name: json['name'] as String,
    );

Map<String, dynamic> _$EventClassToJson(EventClass instance) =>
    <String, dynamic>{
      '_id': instance.id,
      'name': instance.name,
    };
